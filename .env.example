# Dev: leave empty — Vite proxies /api → http://localhost:2026 (no CORS). Restart after edits.
# Production build: set your API host, e.g. https://api.codezloopcode.uk
VITE_API_BASE_URL=

# OAuth (frontend) — GitHub callback is frontend /auth/github/callback, not the API
# VITE_GOOGLE_CLIENT_ID=
# VITE_GITHUB_CLIENT_ID=
# VITE_GITHUB_CLIENT_ID_LOCAL=
# Production callback (dev auto: http://localhost:<vite-port>/auth/github/callback)
# VITE_GITHUB_REDIRECT_URI=https://codezloopcode.uk/auth/github/callback
# VITE_GITHUB_REDIRECT_URI_LOCAL=http://localhost:5173/auth/github/callback